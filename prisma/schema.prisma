  tlReviewer       Employee? @relation("TLReviews", fields: [tlReviewerId], references: [id])
  attendanceFiller Employee? @relation("AttendanceFills", fields: [attendanceFilledById], references: [id])
  reviewers        InternReportReviewer[]

  @@unique([employeeId, weekStart])
}

model InternReportReviewer {
  id                 String    @id @default(cuid())
  reportId           String
  reviewerEmployeeId String
  isPrimary          Boolean   @default(false)
  productivityRating Int?
  ldRating           Int?
  reflectionsRating  Int?
  comment            String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  report   InternWeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewer Employee           @relation("InternReportReviews", fields: [reviewerEmployeeId], references: [id])

  @@unique([reportId, reviewerEmployeeId])
}

