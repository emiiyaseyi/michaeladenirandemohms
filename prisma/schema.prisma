generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            SystemRole     @default(STAFF)
  isActive        Boolean        @default(true)
  mustChangePassword Boolean     @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastLoginAt     DateTime?
  adminRoles             UserAdminRole[]
  accounts               Account[]
  auditLogs              AuditLog[]
  employee               Employee?
  notifications          Notification[]
  announcements          Announcement[]        @relation("AnnouncementCreator")
  orgDocsUploaded        OrgDocument[]         @relation("OrgDocUploader")
  offerTemplates         OfferTemplate[]       @relation("OfferTemplateCreator")
  sessions               Session[]
  profileUpdateReviews   ProfileUpdateRequest[]
  personalDocReviews     PersonalDocument[]    @relation("PersonalDocReviewer")
  passwordResetRequests  PasswordResetRequest[] @relation("PasswordResetUser")
  resolvedResetRequests  PasswordResetRequest[] @relation("PasswordResetResolver")
  exitRequestReviews     ExitRequest[]
}

model Division {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  divisionId    String?
  parentId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  division      Division?      @relation(fields: [divisionId], references: [id])
  parent        Department?    @relation("DeptHierarchy", fields: [parentId], references: [id])
  children      Department[]   @relation("DeptHierarchy")
  employees              Employee[]
  teams                  Team[]
  jobPostings            JobPosting[]
  leaveRequests          LeaveRequest[]
  redeployedFromHere     RedeploymentRequest[] @relation("RedeployFromDept")
  redeployedToHere       RedeploymentRequest[] @relation("RedeployToDept")
  offerLetters           OfferLetter[]
}

model Team {
  id           String           @id @default(cuid())
  name         String
  category     EmployeeCategory @default(NON_TECHNICAL)
  departmentId String?
  headId       String?
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department?      @relation(fields: [departmentId], references: [id])
  head         Employee?        @relation("TeamHead", fields: [headId], references: [id])
  members      Employee[]       @relation("TeamMembership")
}

model Employee {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  userId             String               @unique
  firstName          String
  lastName           String
  middleName         String?
  gender             Gender?
  dateOfBirth        DateTime?
  maritalStatus      MaritalStatus?
  nationality        String?              @default("Nigerian")
  stateOfOrigin      String?
  profilePhoto       String?
  personalEmail      String?
  phone              String?
  alternatePhone     String?
  address            String?
  city               String?
  state              String?
  country            String?              @default("Nigeria")
  postalCode         String?
  departmentId       String?
  jobTitle           String?
  employmentType     EmploymentType       @default(FULL_TIME)
  category           EmployeeCategory     @default(NON_TECHNICAL)
  employeeStatus     EmployeeStatus       @default(ACTIVE)
  hireDate           DateTime?
  confirmationDate   DateTime?
  endDate            DateTime?
  managerId                 String?
  projectLeadId             String?
  secondaryProjectLeadIds   String[]  @default([])
  secondaryDepartmentIds    String[]  @default([])
  teamId                    String?
  bankName           String?
  bankAccountNo      String?
  bankAccountName    String?
  pensionPin         String?
  tin                String?
  nhfNo              String?
  nin                String?
  aiMembership       String?
  grossSalary        Float?
  nokName            String?
  nokPhone           String?
  nokRelationship    String?
  nokAddress         String?
  onProbation        Boolean              @default(false)
  probationEndDate   DateTime?
  annualLeaveBalance Int                  @default(21)
  sickLeaveBalance   Int                  @default(14)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  docAcks            DocAck[]
  documents          Document[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  projectLead        Employee?            @relation("ProjectLeadRelation", fields: [projectLeadId], references: [id])
  projectLeadOf      Employee[]           @relation("ProjectLeadRelation")
  manager            Employee?            @relation("ManagerRelation", fields: [managerId], references: [id])
  directReports      Employee[]           @relation("ManagerRelation")
  team               Team?                @relation("TeamMembership", fields: [teamId], references: [id])
  ledTeams           Team[]               @relation("TeamHead")
  profileUpdateRequests ProfileUpdateRequest[]
  personalDocuments  PersonalDocument[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackGiven      Feedback[]           @relation("FeedbackGiver")
  feedbackReceived   Feedback[]           @relation("FeedbackReceiver")
  jobApplications    JobApplication[]
  kpis               KPI[]
  leaveApprovals     LeaveApproval[]
  leaveBalances      LeaveBalance[]
  reliefAssignments  LeaveReliefOfficer[] @relation("ReliefAssignments")
  leaveRequests      LeaveRequest[]       @relation("EmployeeLeave")
  reliefFor          LeaveRequest[]       @relation("ReliefOfficer")
  notifications      Notification[]       @relation("EmployeeNotifications")
  offboarding        Offboarding?
  exitRequests       ExitRequest[]
  onboardingTasks    OnboardingTask[]
  projectAssignments ProjectAssignment[]
  payslips           Payslip[]
  signatoryRecord    CompanySignatory?
  loanRequests         LoanRequest[]
  salaryAdvances       SalaryAdvanceRequest[]
  redeploymentRequests RedeploymentRequest[]
  documentRequests     DocumentRequest[]
  offerLettersSent     OfferLetter[]        @relation("OfferManager")
  customGroupMemberships CustomGroupMember[]
  surveyResponses        SurveyResponse[]
  performanceGroupMemberships PerformanceGroupMember[]
  conversationSetups          ConversationSetup[]
  feedbackRequestsSent        FeedbackRequest[]        @relation("FeedbackRequester")
  feedbackRequestsReceived    FeedbackRequest[]        @relation("FeedbackTarget")
  rentDocuments               RentDocument[]
  disciplinaryTriggers        DisciplinaryTrigger[]
  violationsReceived          Violation[]              @relation("ViolationEmployee")
  violationsRecorded          Violation[]              @relation("ViolationRecorder")
  suspensions                 Suspension[]
  absenceRecords              AbsenceRecord[]
  policyExemptions            DisciplinaryPolicyExemption[]
  assetAssignments            AssetAssignment[]
  benefitEnrollments          BenefitEnrollment[]
}

model Document {
  id           String       @id @default(cuid())
  employeeId   String
  name         String
  type         DocumentType
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  expiryDate   DateTime?
  version      Int          @default(1)
  isLatest     Boolean      @default(true)
  uploadedById String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Announcement {
  id            String              @id @default(cuid())
  title         String
  body          String?             @db.Text
  type          AnnouncementType    @default(TEXT)
  videoUrl      String?
  imageUrl      String?
  behavior      AnnouncementBehavior @default(NOTIFICATION_BAR)
  status        AnnouncementStatus  @default(DRAFT)
  targetRoles   String[]            @default([])
  sendEmail     Boolean             @default(false)
  publishedAt   DateTime?
  retiredAt     DateTime?
  createdById   String
  createdBy     User                @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum AnnouncementType {
  TEXT
  IMAGE
  VIDEO
}

enum AnnouncementBehavior {
  POPUP
  NOTIFICATION_BAR
  DASHBOARD_SCROLL
  EMAIL_ONLY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model OrgDocument {
  id                     String         @id @default(cuid())
  title                  String
  category               OrgDocCategory @default(OTHER)
  description            String?
  fileUrl                String
  fileSize               Int?
  mimeType               String?
  canView                Boolean        @default(true)
  canDownload            Boolean        @default(false)
  canCopy                Boolean        @default(true)
  requiresAck            Boolean        @default(false)
  requiresSignature      Boolean        @default(false)
  sentToCurrentEmployees Boolean        @default(false)
  includeInOnboarding    Boolean        @default(false)
  sentAt                 DateTime?
  isActive               Boolean        @default(true)
  uploadedById           String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  acknowledgments        DocAck[]
  uploadedBy             User           @relation("OrgDocUploader", fields: [uploadedById], references: [id])
}

model DocAck {
  id             String      @id @default(cuid())
  documentId     String
  employeeId     String
  acknowledged   Boolean     @default(false)
  acknowledgedAt DateTime?
  signatureUrl   String?
  createdAt      DateTime    @default(now())
  document       OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  departmentId   String?
  description    String
  requirements   String?
  employmentType EmploymentType   @default(FULL_TIME)
  location       String?
  salaryMin      Float?
  salaryMax      Float?
  isInternal     Boolean          @default(false)
  status         JobStatus        @default(DRAFT)
  openDate       DateTime?
  closeDate      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
  department     Department?      @relation(fields: [departmentId], references: [id])
}

model JobApplication {
  id              String            @id @default(cuid())
  jobPostingId    String
  employeeId      String?
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  resumeUrl       String?
  coverLetter     String?
  stage           ApplicationStage  @default(APPLICATION)
  status          ApplicationStatus @default(ACTIVE)
  notes           String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  offer           Offer?
}

model Offer {
  id            String         @id @default(cuid())
  applicationId String         @unique
  salary        Float
  startDate     DateTime?
  expiryDate    DateTime?
  status        OfferStatus    @default(PENDING)
  terms         String?
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model OfferLetter {
  id             String      @id @default(cuid())
  candidateName  String
  candidateEmail String
  jobTitle       String?
  departmentId   String?
  managerId      String?
  hireDate       DateTime?
  salary         Float?
  letterText     String?
  status         OfferStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  department     Department? @relation(fields: [departmentId], references: [id])
  manager        Employee?   @relation("OfferManager", fields: [managerId], references: [id])
}

model CustomGroup {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String?
  groupByCurrency Boolean             @default(false)
  status          String              @default("ACTIVE")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         CustomGroupMember[]
}

model CustomGroupMember {
  id         String      @id @default(cuid())
  groupId    String
  employeeId String
  createdAt  DateTime    @default(now())
  group      CustomGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([groupId, employeeId])
}

model OnboardingTask {
  id          String             @id @default(cuid())
  employeeId  String
  title       String
  description String?
  category    OnboardingCategory @default(HR)
  assignedTo  String?
  dueDate     DateTime?
  status      TaskStatus         @default(PENDING)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveType {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  defaultDays     Int            @default(21)
  genderSpecific  Gender?
  waitingDays     Int            @default(0)
  rolloverPolicy  Boolean        @default(false)
  excludeWeekends Boolean        @default(true)
  requiresDoc     Boolean        @default(false)
  minDocDays      Int            @default(2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
}

model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  year      Int
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JobTitle {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanRequest {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyName       String?
  amount           Float
  repaymentTenor   Int
  interval         String   @default("Months")
  reason           String?
  noteForUser      String?
  documentUrl      String?
  status           String   @default("PENDING")
  disburseWithPayroll Boolean @default(false)
  deductFromPayroll   Boolean @default(false)
  declineReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SalaryAdvanceRequest {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policyName     String?
  amount         Float
  repaymentTenor Int
  interval       String   @default("Months")
  reason         String?
  noteForUser    String?
  documentUrl    String?
  status         String   @default("PENDING")
  declineReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LeaveFreezeperiod {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id                 String               @id @default(cuid())
  employeeId         String
  departmentId       String?
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  days               Int
  reason             String
  handoverNotes      String?
  documentUrl        String?
  status             LeaveStatus          @default(PENDING)
  version            Int                  @default(1)
  parentLeaveId      String?
  reliefEmployeeId   String?
  resumedAt          DateTime?
  reliefRating       Int?
  reliefComment      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ratingPromptShown  Boolean              @default(false)
  projectLeadIds     String?
  approvals          LeaveApproval[]
  reliefOfficersList LeaveReliefOfficer[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  employee           Employee             @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType            @relation(fields: [leaveTypeId], references: [id])
  parentLeave        LeaveRequest?        @relation("LeaveReliefOfficers", fields: [parentLeaveId], references: [id])
  reliefOfficers     LeaveRequest[]       @relation("LeaveReliefOfficers")
  reliefEmployee     Employee?            @relation("ReliefOfficer", fields: [reliefEmployeeId], references: [id])
}

model LeaveApproval {
  id             String          @id @default(cuid())
  leaveRequestId String
  employeeId     String
  stage          ApprovalStage
  action         ApprovalAction?
  comment        String?
  actedAt        DateTime?
  deadline       DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employee       Employee        @relation(fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
}

model PerformanceCycle {
  id          String      @id @default(cuid())
  name        String
  year        Int
  half        Int         @default(1)
  startDate   DateTime
  endDate     DateTime
  kpiDeadline DateTime?
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  kpis        KPI[]
}

model KPI {
  id            String            @id @default(cuid())
  employeeId    String
  cycleId       String
  title         String
  description   String?
  keyResultArea String?
  weight        Float
  target        String?
  deadline      DateTime?
  projectName   String?
  ownerId       String?
  status        KPIStatus         @default(DRAFT)
  kpiStatus     KPIProgressStatus @default(NOT_STARTED)
  progress      Int               @default(0)
  evidenceUrl   String?
  selfScore     Float?
  managerScore  Float?
  finalScore    Float?
  comments      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cycle         PerformanceCycle  @relation(fields: [cycleId], references: [id])
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String       @id @default(cuid())
  giverId     String
  receiverId  String
  type        FeedbackType @default(PEER)
  rating      Float?
  comment     String?
  isAnonymous Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  giver       Employee     @relation("FeedbackGiver", fields: [giverId], references: [id])
  receiver    Employee     @relation("FeedbackReceiver", fields: [receiverId], references: [id])
}

model RentDocument {
  id                  String             @id @default(cuid())
  employeeId          String
  amount              Float
  rentStart           DateTime
  rentEnd             DateTime
  propertyAddress     String
  landlordName        String?
  landlordPhone       String?
  landlordEmail       String?
  rentReceiptUrl      String?
  tenancyAgreementUrl String?
  status              RentDocumentStatus @default(TO_REVIEW)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  employee            Employee           @relation(fields: [employeeId], references: [id])
}

enum RentDocumentStatus {
  APPROVED
  DECLINED
  TO_REVIEW
}

model ViolationType {
  id         String               @id @default(cuid())
  name       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  violations Violation[]
  policies   DisciplinaryPolicy[]
}

model Violation {
  id                String          @id @default(cuid())
  employeeId        String
  recordedById      String
  violationTypeId   String
  incidentDate      DateTime
  details           String
  expectingResponse Boolean         @default(false)
  supportingDocUrl  String?
  reviewNote        String?
  status            ViolationStatus @default(TO_REVIEW)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employee          Employee        @relation("ViolationEmployee", fields: [employeeId], references: [id])
  recordedBy        Employee        @relation("ViolationRecorder", fields: [recordedById], references: [id])
  violationType     ViolationType   @relation(fields: [violationTypeId], references: [id])
}

enum ViolationStatus {
  APPROVED
  DECLINED
  TO_REVIEW
}

model DisciplinaryTrigger {
  id          String                    @id @default(cuid())
  employeeId  String
  action      String
  description String?
  triggerDate DateTime
  status      DisciplinaryTriggerStatus @default(PENDING_REVIEW)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  employee    Employee                  @relation(fields: [employeeId], references: [id])
}

enum DisciplinaryTriggerStatus {
  APPROVED
  DECLINED
  PENDING_REVIEW
}

model Suspension {
  id               String           @id @default(cuid())
  employeeId       String
  startDate        DateTime
  endDate          DateTime?
  reason           String?
  noteForUser      String?
  supportingDocUrl String?
  alreadyOccurred  Boolean          @default(true)
  status           SuspensionStatus @default(TO_REVIEW)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         Employee         @relation(fields: [employeeId], references: [id])
}

enum SuspensionStatus {
  TO_REVIEW
  APPROVED
  DECLINED
  PENDING
  SUSPENDED
}

model DisciplinaryPolicy {
  id              String                        @id @default(cuid())
  name            String
  violationTypeId String?
  violationType   ViolationType?                @relation(fields: [violationTypeId], references: [id])
  systemAction    String?
  hasThreshold    Boolean                       @default(false)
  violationCount  Int?
  description     String?
  isActive        Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  exemptions      DisciplinaryPolicyExemption[]
}

model DisciplinaryPolicyExemption {
  id         String             @id @default(cuid())
  policyId   String
  policy     DisciplinaryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([policyId, employeeId])
}

model AbsenceBatch {
  id          String          @id @default(cuid())
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  records     AbsenceRecord[]
}

model AbsenceRecord {
  id          String        @id @default(cuid())
  batchId     String
  employeeId  String
  absentStart DateTime
  absentEnd   DateTime
  totalDays   Int
  reason      String
  note        String?
  status      AbsenceStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  batch       AbsenceBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee    Employee      @relation(fields: [employeeId], references: [id])
}

enum AbsenceStatus {
  NEW
  APPROVED
  DECLINED
}

model FeedbackRequest {
  id          String                @id @default(cuid())
  requesterId String
  targetId    String
  message     String?
  status      FeedbackRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  requester   Employee              @relation("FeedbackRequester", fields: [requesterId], references: [id])
  target      Employee              @relation("FeedbackTarget", fields: [targetId], references: [id])
}

enum FeedbackRequestStatus {
  PENDING
  FULFILLED
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  status      ProjectStatus       @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id         String    @id @default(cuid())
  projectId  String
  employeeId String
  role       String?
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model Offboarding {
  id             String            @id @default(cuid())
  employeeId     String            @unique
  exitType       ExitType
  lastWorkingDay DateTime
  reason         String?
  status         OffboardingStatus @default(INITIATED)
  initiatedAt    DateTime          @default(now())
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks          OffboardingTask[]
}

model OffboardingTask {
