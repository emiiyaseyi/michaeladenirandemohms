model BusBooking {
  id          String           @id @default(cuid())
  employeeId  String
  userId      String
  bookingDate DateTime         // midnight UTC of the day (Mon/Wed/Fri)
  trip        BusTripType
  stop        String           // pickup (morning) or dropoff (afternoon) stop name
  seatNumber  Int?             // null until allocation cron assigns it
  bookedAt    DateTime         @default(now())
  status      BusBookingStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employeeId, bookingDate, trip])
}

enum BusTripType {
  MORNING
  AFTERNOON
}

enum BusBookingStatus {
  PENDING
  CONFIRMED
  BOUNCED
  CANCELLED
}

