model InternReportSettings {
  id                       String   @id @default("singleton")
  submissionDay            Int      @default(5)   // 0=Sun … 5=Fri … 6=Sat
  openHour                 Int      @default(16)  // WAT hour when window opens on submissionDay
  openMinute               Int      @default(0)   // WAT minute (0-59)
  lateHour                 Int      @default(20)  // WAT hour after which Friday submission is LATE
  lateMinute               Int      @default(0)   // WAT minute (0-59)
  closeHour                Int      @default(24)  // legacy - no longer used (window now closes Sun 23:59)
  lateDeductionSameDay     Int      @default(1)   // points deducted for late submissions still on submissionDay
  lateDeduction            Int      @default(2)   // points deducted for Saturday submissions
  lateDeductionSunday      Int      @default(3)   // points deducted for Sunday submissions
  missingWeeklyDeduction   Int      @default(10)  // points deducted per week a report remains unsubmitted, applied every Monday
  warningThresholdMinutes  Int      @default(15)  // minutes before lateHour that the countdown turns red
  reviewerDeadlineDay      Int      @default(7)   // days after weekStart for reviewer deadline
  reviewerDeadlineHour     Int      @default(8)   // WAT hour of reviewer deadline
  reviewerDeadlineMinute   Int      @default(0)   // WAT minute of reviewer deadline
  attendanceCriteria       Json?
  updatedAt                DateTime @updatedAt
}
