enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String
  leadId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  department   Department    @relation(fields: [departmentId], references: [id])
  lead         Employee      @relation("ProjectLead", fields: [leadId], references: [id])
  members      ProjectMember[]
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  employeeId  String
  projectRole String?
  assignedAt  DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model InternReportSettings {
  id                       String   @id @default("singleton")
  submissionDay            Int      @default(5)   // 0=Sun … 5=Fri … 6=Sat
  openHour                 Int      @default(16)  // WAT hour when window opens on submissionDay
  lateHour                 Int      @default(20)  // WAT hour after which Friday submission is LATE
  closeHour                Int      @default(24)  // legacy — no longer used (window now closes Sun 23:59)
  lateDeduction            Int      @default(2)   // points deducted for Saturday submissions
  lateDeductionSunday      Int      @default(3)   // points deducted for Sunday submissions
  warningThresholdMinutes  Int      @default(15)  // minutes before lateHour that the countdown turns red
  attendanceCriteria       Json?
  updatedAt                DateTime @updatedAt
}
