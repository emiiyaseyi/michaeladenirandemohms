enum SuccessorReadiness {
  READY_NOW
  READY_SOON
  LONG_TERM
}

enum PayslipStatus {
  DRAFT
  PENDING
  RELEASED
}

model Payslip {
  id              String        @id @default(cuid())
  employeeId      String
  month           Int           // 1-12
  year            Int
  grossSalary     Float
  basicSalary     Float
  housing         Float         @default(0)
  transport       Float         @default(0)
  meal            Float         @default(0)
  otherAllowances Float         @default(0)
  payeTax         Float         @default(0)
  pension         Float         @default(0)
  nhf             Float         @default(0)
  healthInsurance Float         @default(0)
  otherDeductions Float         @default(0)
  netPay          Float
  status          PayslipStatus @default(DRAFT)
  notes           String?
  releasedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

enum ProfileUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfileUpdateRequest {
  id          String              @id @default(cuid())
  employeeId  String
  changes     Json
  status      ProfileUpdateStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation(fields: [reviewedBy], references: [id])
}

enum PersonalDocType {
  SSCE
  FIRST_DEGREE
  NYSC
  PROFESSIONAL_CERT
  UTILITY_BILL
  OTHER
}

enum PersonalDocStatus {
  PENDING
  APPROVED
  REJECTED
}

model PersonalDocument {
  id          String            @id @default(cuid())
  employeeId  String
  type        PersonalDocType
  fileUrl     String
  fileName    String
  notes       String?
  status      PersonalDocStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User?             @relation("PersonalDocReviewer", fields: [reviewedBy], references: [id])
}
