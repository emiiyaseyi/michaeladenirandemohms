enum InternReportStatus {
  DRAFT
  SUBMITTED
  LATE
  REVIEWED
  MISSING
}

model InternWeeklyReport {
  id                   String             @id @default(cuid())
  employeeId           String
  weekStart            DateTime
  weekEnd              DateTime
  mainProjectHours     Float              @default(0)
  consultingHours      Float              @default(0)
  specialProjectHours  Float              @default(0)
  trainingHours        Float              @default(0)
  newBusinessHours     Float              @default(0)
  reportingDocHours    Float              @default(0)
  operationalHours     Float              @default(0)
  researchHours        Float              @default(0)
  meetingsHours        Float              @default(0)
  communityHours       Float              @default(0)
  representationHours  Float              @default(0)
  selfDevHours         Float              @default(0)
  totalHours           Float              @default(0)
  taskDescriptions     Json?
  personalReflection   String?
  dailyReflections     Json?
  generalReflection    String?
  submittedAt          DateTime?
  lateFlag             Boolean            @default(false)
  status               InternReportStatus @default(DRAFT)
  productivityRating   Int?
  ldRating             Int?
  reflectionsRating    Int?
  tlComment            String?
  tlReviewedAt         DateTime?
  tlReviewerId         String?
  attendanceRating     Int?
  attendanceComment    String?
  attendanceFilledAt   DateTime?
  attendanceFilledById String?
  pointDeduction       Int                @default(0)
