generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            SystemRole     @default(STAFF)
  isActive        Boolean        @default(true)
  mustChangePassword Boolean     @default(true)
  // True for accounts created by prisma/seed.ts or prisma/seed-test.ts.
  // sendEmail() in src/lib/email.ts drops these recipients to prevent fake
  // seed emails (e.g. @michaeldemohrms.example, manager1@…) from being sent in real
  // production once email delivery is enabled.
  // Flip to false (or delete the account) once a real user takes over.
  isSeeded        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastLoginAt     DateTime?
  adminRoles             UserAdminRole[]
  accounts               Account[]
  auditActorLogs         AuditLog[]            @relation("AuditActor")
  auditTargetLogs        AuditLog[]            @relation("AuditTarget")
  employee               Employee?
  notifications          Notification[]
  announcements          Announcement[]        @relation("AnnouncementCreator")
  orgDocsUploaded        OrgDocument[]         @relation("OrgDocUploader")
  offerTemplates         OfferTemplate[]       @relation("OfferTemplateCreator")
  sessions               Session[]
  profileUpdateReviews   ProfileUpdateRequest[]
  personalDocReviews     PersonalDocument[]    @relation("PersonalDocReviewer")
  passwordResetRequests  PasswordResetRequest[] @relation("PasswordResetUser")
  resolvedResetRequests  PasswordResetRequest[] @relation("PasswordResetResolver")
  projectLeadDepartments ProjectLeadDepartment[]
  busBookings            BusBooking[]
}

model Division {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  phone           String?
  email           String?
  divisionId      String?
  parentId        String?
  leadEmployeeId  String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  division        Division?      @relation(fields: [divisionId], references: [id])
  parent          Department?    @relation("DeptHierarchy", fields: [parentId], references: [id])
  children        Department[]   @relation("DeptHierarchy")
  lead            Employee?      @relation("DepartmentLead", fields: [leadEmployeeId], references: [id])
  employees              Employee[]
  jobPostings            JobPosting[]
  leaveRequests          LeaveRequest[]
  offerLetters           OfferLetter[]
  projectLeads           ProjectLeadDepartment[]
  memberships            EmployeeDepartment[]
  projects               Project[]
}

model Manager {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeDepartment {
  id           String     @id @default(cuid())
  employeeId   String
  departmentId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, departmentId])
  @@index([departmentId])
}

model Employee {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  userId             String               @unique
  firstName          String
  lastName           String
  middleName         String?
  gender             Gender?
  dateOfBirth        DateTime?
  maritalStatus      MaritalStatus?
  nationality        String?              @default("Nigerian")
  stateOfOrigin      String?
  profilePhoto       String?
  personalEmail      String?
  phone              String?
  alternatePhone     String?
  address            String?
  city               String?
  state              String?
  country            String?              @default("Nigeria")
  postalCode         String?
  departmentId       String?
  jobTitle           String?
  employmentType     EmploymentType       @default(FULL_TIME)
  employeeStatus     EmployeeStatus       @default(ACTIVE)
  hireDate           DateTime?
  internReportStartDate DateTime? // admin override: first week this intern is required to submit weekly reports (defaults to account creation date)
  confirmationDate   DateTime?
  convertedAt        DateTime?
  endDate            DateTime?
  managerId                 String?
  projectLeadId             String?
  secondaryProjectLeadIds   String[]  @default([])
  secondaryDepartmentIds    String[]  @default([])
  nin                String?
  aiMembership       String?
  nokName            String?
  nokPhone           String?
  nokRelationship    String?
  nokAddress         String?
  onProbation        Boolean              @default(false)
  probationEndDate   DateTime?
  annualLeaveBalance Int                  @default(10)
  sickLeaveBalance   Int                  @default(5)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  docAcks            DocAck[]
  documents          Document[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  projectLead        Employee?            @relation("ProjectLeadRelation", fields: [projectLeadId], references: [id])
  projectLeadOf      Employee[]           @relation("ProjectLeadRelation")
  manager            Employee?            @relation("ManagerRelation", fields: [managerId], references: [id])
  directReports      Employee[]           @relation("ManagerRelation")
  profileUpdateRequests ProfileUpdateRequest[]
  personalDocuments  PersonalDocument[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplications    JobApplication[]
  leaveApprovals     LeaveApproval[]
  leaveBalances      LeaveBalance[]
  reliefAssignments  LeaveReliefOfficer[] @relation("ReliefAssignments")
  leaveRequests      LeaveRequest[]       @relation("EmployeeLeave")
  reliefFor          LeaveRequest[]       @relation("ReliefOfficer")
  notifications      Notification[]       @relation("EmployeeNotifications")
  documentRequests     DocumentRequest[]
  offerLettersSent     OfferLetter[]        @relation("OfferManager")
  customGroupMemberships CustomGroupMember[]
  surveyResponses        SurveyResponse[]
  appraisals                  Appraisal[]              @relation("AppraisalSubject")
  appraisalRatings            AppraisalRating[]        @relation("AppraisalRater")
  appraisalReviews            AppraisalReviewer[]      @relation("AppraisalReviewerEmp")
  appraisalPeerReviews        AppraisalPeer[]          @relation("AppraisalPeerEmp")
  leaderboardEntries          LeaderboardEntry[]
  rentDocuments               RentDocument[]
  disciplinaryTriggers        DisciplinaryTrigger[]
  violationsReceived          Violation[]              @relation("ViolationEmployee")
  violationsRecorded          Violation[]              @relation("ViolationRecorder")
  suspensions                 Suspension[]
  absenceRecords              AbsenceRecord[]
  policyExemptions            DisciplinaryPolicyExemption[]
  assetAssignments            AssetAssignment[]
  benefitEnrollments          BenefitEnrollment[]
  invite             EmployeeInvite?
  internReports       InternWeeklyReport[] @relation("InternReports")
  busBookings         BusBooking[]
  managerEntry           Manager?
  departmentMemberships  EmployeeDepartment[]
  departmentsLed         Department[]              @relation("DepartmentLead")
  plReviews           InternWeeklyReport[] @relation("PLReviews")
  attendanceFills     InternWeeklyReport[] @relation("AttendanceFills")
  internReportReviews InternReportReviewer[] @relation("InternReportReviews")
  projectsLed         Project[]             @relation("ProjectLead")
  projectMemberships  ProjectMember[]
}

model Document {
  id           String       @id @default(cuid())
  employeeId   String
  name         String
  type         DocumentType
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  expiryDate   DateTime?
  version      Int          @default(1)
  isLatest     Boolean      @default(true)
  uploadedById String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Announcement {
  id            String              @id @default(cuid())
  title         String
  body          String?             @db.Text
  type          AnnouncementType    @default(TEXT)
  videoUrl      String?
  imageUrl      String?
  behavior      AnnouncementBehavior @default(NOTIFICATION_BAR)
  status        AnnouncementStatus  @default(DRAFT)
  targetRoles   String[]            @default([])
  sendEmail     Boolean             @default(false)
  publishedAt   DateTime?
  retiredAt     DateTime?
  createdById   String
  createdBy     User                @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum AnnouncementType {
  TEXT
  IMAGE
  VIDEO
}

enum AnnouncementBehavior {
  POPUP
  NOTIFICATION_BAR
  DASHBOARD_SCROLL
  EMAIL_ONLY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model OrgDocument {
  id                     String         @id @default(cuid())
  title                  String
  category               OrgDocCategory @default(OTHER)
  description            String?
  fileUrl                String
  fileSize               Int?
  mimeType               String?
  canView                Boolean        @default(true)
  canDownload            Boolean        @default(false)
  canCopy                Boolean        @default(true)
  requiresAck            Boolean        @default(false)
  requiresSignature      Boolean        @default(false)
  sentToCurrentEmployees Boolean        @default(false)
  includeInOnboarding    Boolean        @default(false)
  sentAt                 DateTime?
  isActive               Boolean        @default(true)
  uploadedById           String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  acknowledgments        DocAck[]
  uploadedBy             User           @relation("OrgDocUploader", fields: [uploadedById], references: [id])
}

model DocAck {
  id             String      @id @default(cuid())
  documentId     String
  employeeId     String
  acknowledged   Boolean     @default(false)
  acknowledgedAt DateTime?
  signatureUrl   String?
  createdAt      DateTime    @default(now())
  document       OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  departmentId   String?
  description    String
  requirements   String?
  employmentType EmploymentType   @default(FULL_TIME)
  location       String?
  salaryMin      Float?
  salaryMax      Float?
  isInternal     Boolean          @default(false)
  status         JobStatus        @default(DRAFT)
  openDate       DateTime?
  closeDate      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
  department     Department?      @relation(fields: [departmentId], references: [id])
}

model JobApplication {
  id              String            @id @default(cuid())
  jobPostingId    String
  employeeId      String?
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  resumeUrl       String?
  coverLetter     String?
  stage           ApplicationStage  @default(APPLICATION)
  status          ApplicationStatus @default(ACTIVE)
  notes           String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  offerLetter     OfferLetter?
}

model OfferLetter {
  id               String          @id @default(cuid())
  candidateName    String
  candidateEmail   String
  jobTitle         String?
  departmentId     String?
  managerId        String?
  hireDate         DateTime?
  salary           Float?
  letterText       String?
  status           OfferStatus     @default(PENDING)
  jobApplicationId String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  department       Department?     @relation(fields: [departmentId], references: [id])
  manager          Employee?       @relation("OfferManager", fields: [managerId], references: [id])
  jobApplication   JobApplication? @relation(fields: [jobApplicationId], references: [id])
}

model CustomGroup {
  id              String              @id @default(cuid())
  name            String              @unique
  description     String?
  groupByCurrency Boolean             @default(false)
  status          String              @default("ACTIVE")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         CustomGroupMember[]
}

model CustomGroupMember {
  id         String      @id @default(cuid())
  groupId    String
  employeeId String
  createdAt  DateTime    @default(now())
  group      CustomGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([groupId, employeeId])
}

model LeaveType {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  defaultDays      Int            @default(21)
  genderSpecific   Gender?
  waitingDays      Int            @default(0)
  rolloverPolicy   Boolean        @default(false)
  excludeWeekends  Boolean        @default(true)
  requiresDoc      Boolean        @default(false)
  minDocDays       Int            @default(2)
  minNoticeDays    Int            @default(10)
  internOnly       Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
}

model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  year      Int
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JobTitle {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model LeaveFreezeperiod {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id                 String               @id @default(cuid())
  employeeId         String
  departmentId       String?
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  days               Int
  reason             String
  handoverNotes      String?
  documentUrl        String?
  status             LeaveStatus          @default(PENDING)
  version            Int                  @default(1)
  parentLeaveId      String?
  reliefEmployeeId   String?
  resumedAt          DateTime?
  reliefRating       Int?
  reliefComment      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ratingPromptShown  Boolean              @default(false)
  projectLeadIds     String?
  approvals          LeaveApproval[]
  reliefOfficersList LeaveReliefOfficer[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  employee           Employee             @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType            @relation(fields: [leaveTypeId], references: [id])
  parentLeave        LeaveRequest?        @relation("LeaveReliefOfficers", fields: [parentLeaveId], references: [id])
  reliefOfficers     LeaveRequest[]       @relation("LeaveReliefOfficers")
  reliefEmployee     Employee?            @relation("ReliefOfficer", fields: [reliefEmployeeId], references: [id])
}

model LeaveApproval {
  id             String          @id @default(cuid())
  leaveRequestId String
  employeeId     String
  stage          ApprovalStage
  action         ApprovalAction?
  comment        String?
  actedAt        DateTime?
  deadline       DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employee       Employee        @relation(fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
}

model PerformanceCycle {
  id          String      @id @default(cuid())
  name        String
  year        Int
  half        Int         @default(1)
  startDate   DateTime
  endDate     DateTime
  kpiDeadline DateTime?
  isActive    Boolean     @default(false)
  closedAt    DateTime?   // set when admin closes the cycle; gates send-once of final report emails
  // ── Appraisal configuration ──
  stage               AppraisalCycleStage @default(CONFIG)
  peerCount           Int                 @default(3)
  weights             Json?   // { behavioural, jobSpecific, coreValues, recommendation, query }
  queryBands          Json?   // [{ minWarnings, maxWarnings, points, label }]
  recommendationBands Json?   // [{ min, max, points, label }]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  questions   AppraisalQuestion[]
  appraisals  Appraisal[]
  globalKpis  AppraisalGlobalKpi[]
  leaderboard LeaderboardEntry[]
}

// Admin-imported leaderboard for org-wide admin-scored items (Brand, Learning, Attendance).
// Drives the ADMIN-source scores in each appraisal AND is shown on the Leaderboards page so
// staff can see where those numbers came from and validate them.
model LeaderboardEntry {
  id         String   @id @default(cuid())
  cycleId    String
  category   String   // "BRAND" | "LEARNING" | "ATTENDANCE"
  employeeId String
  score      Float
  note       String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([cycleId, category, employeeId])
  @@index([cycleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ─── Half-Year Performance Appraisal ─────────────────────────────────────────

enum AppraisalCycleStage {
  CONFIG      // admin sets up questions, weights, reviewers, peers
  OPEN        // employee self-fill + peers fill simultaneously
  REVIEW      // team lead + counter reviewer score
  COMPILING   // admin/management finalize
  FINALIZED   // locked, results visible to all
}

enum AppraisalStage {
  NOT_STARTED
  DRAFT
  SUBMITTED
  LEAD_REVIEWING
  LEAD_DONE
  FINALIZED
}

enum AppraisalSection {
  BEHAVIOURAL   // Section II - team-member behavioural items; self + lead + peer rate (the 360)
  LEADERSHIP    // upward leadership items; a lead's reports rate them → Team Lead Score
  CORE_VALUE    // Section IV - self + reviewer scored
  PEER          // legacy - retained for back-compat; peers now rate BEHAVIOURAL
}

enum RaterType {
  SELF
  PEER
  MEMBER
  PRIMARY_REVIEWER
  COUNTER_REVIEWER
  ADMIN              // HR/admin-entered score (e.g. attendance) - locked from staff & lead
}

enum ReviewerRole {
  PRIMARY   // direct team lead
  COUNTER   // HR-assigned second lead
}

enum AppraisalKpiSource {
  STAFF
  ADMIN     // global rows (Learning & Development, Strategic Brand Visibility)
}

model AppraisalQuestion {
  id        String            @id @default(cuid())
  cycleId   String
  section   AppraisalSection
  text      String
  scaleMax  Int               @default(5)
  order     Int               @default(0)
  adminScored Boolean         @default(false) // admin enters an extra locked score (e.g. attendance)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  cycle     PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ratings   AppraisalRating[]

  @@index([cycleId])
}

model AppraisalGlobalKpi {
  id          String            @id @default(cuid())
  cycleId     String
  projectName String            // e.g. "Learning & Development"
  deliverable String?
  kpi         String?
  weight      Float             @default(0)
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  cycle       PerformanceCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
}

model Appraisal {
  id         String          @id @default(cuid())
  cycleId    String
  employeeId String
  stage      AppraisalStage  @default(NOT_STARTED)
  // Section VII - Improvement / comments
  keyAchievements         String?
  areasForImprovement     String?
  developmentPlan         String?
  employeeComments        String?
  employeeImprovementPlan String?   // staff's own improvement plan (Section VII)
  reviewerComments        String?
  counterReviewerComments String?
  managementComment       String?   // admin/management final comment per staff (Section VII) - admin-only, survives reopen
  // Team-lead upward review - LLM synthesis of the lead's team-member reviews (raw rows stay sealed).
  teamLeadReviewSummary   String?   // generated markdown report (lead + HR see this; never the raw rows)
  teamLeadReviewSummaryAt DateTime?
  teamLeadReviewCount     Int?      // # of member raters that fed in (gate: needs >= 3 to generate)
  // Section V - Query (negative points). Counts entered by staff (self) + HR; points auto-derived from bands.
  queryWarnings      Int?      // staff self count
  queryBadges        Int?
  queryWarningsHr    Int?      // HR count
  queryBadgesHr      Int?
  queryEmployeeRating Float?   // derived from staff counts
  queryHrRating      Float?    // derived from HR counts
  queryComment       String?
  // Section VI - Recommendations (positive points). Counts entered by staff + HR; points auto-derived.
  recCount           Int?      // staff self count
  recCountHr         Int?      // HR count
  recEmployeeRating  Float?    // derived
  recHrRating        Float?    // derived
  recComment         String?
  // Section VII-b - Physical meeting confirmation
  meetingEmployeeConfirmed Boolean @default(false)
  meetingReviewerConfirmed Boolean @default(false)
  // Computed score snapshot (set at finalize)
  behavioural360Score Float?   // legacy combined pool (kept for back-compat)
  behavioural360Emp   Float?   // self behavioural (Employee column)
  behavioural360Rev   Float?   // lead + peer + member-upward (Reviewer column)
  jobScoreEmp         Float?
  jobScoreRev         Float?
  coreScoreEmp        Float?
  coreScoreRev        Float?
  finalEmployeePercent Float?
  finalReviewerPercent Float?
  finalPercent         Float?
  teamLeadPercent      Float?
  submittedAt        DateTime?
  finalizedAt        DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  cycle      PerformanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee   Employee            @relation("AppraisalSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  ratings    AppraisalRating[]
  kpis       AppraisalKpi[]
  reviewers  AppraisalReviewer[]
  peers      AppraisalPeer[]

  @@unique([cycleId, employeeId])
  @@index([employeeId])
}

model AppraisalRating {
  id          String            @id @default(cuid())
  appraisalId String
  raterId     String?
  raterType   RaterType
  section     AppraisalSection
  questionId  String?
  score       Float?
  comment     String?
  isAnonymous Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  appraisal   Appraisal         @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  rater       Employee?         @relation("AppraisalRater", fields: [raterId], references: [id])
  question    AppraisalQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([appraisalId])
  @@index([raterId])
}

model AppraisalKpi {
  id          String             @id @default(cuid())
  appraisalId String
  projectName String?
  deliverable String?
  kpi         String?
  weight      Float              @default(0)
  employeeScore   Float?
  primaryScore    Float?
  counterScore    Float?
  reviewerScore   Float?
  evidenceUrl     String?
  employeeComment String?
  reviewerComment String?   // legacy shared reviewer comment
  primaryComment  String?   // team lead's comment
  counterComment  String?   // counter reviewer's comment
  source      AppraisalKpiSource @default(STAFF)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  appraisal   Appraisal          @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId])
}

model AppraisalReviewer {
  id          String       @id @default(cuid())
  appraisalId String
  reviewerId  String
  role        ReviewerRole
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  appraisal   Appraisal    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  reviewer    Employee     @relation("AppraisalReviewerEmp", fields: [reviewerId], references: [id])

  @@unique([appraisalId, role])
  @@index([reviewerId])
}

model AppraisalPeer {
  id          String    @id @default(cuid())
  appraisalId String
  peerId      String
  status      String    @default("PENDING") // PENDING | SUBMITTED
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  appraisal   Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  peer        Employee  @relation("AppraisalPeerEmp", fields: [peerId], references: [id])

