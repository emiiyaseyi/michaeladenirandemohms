generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String?        @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            SystemRole     @default(STAFF)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastLoginAt     DateTime?
  additionalRoles SystemRole[]   @default([])
  accounts               Account[]
  auditLogs              AuditLog[]
  employee               Employee?
  notifications          Notification[]
  announcements          Announcement[]        @relation("AnnouncementCreator")
  orgDocsUploaded        OrgDocument[]         @relation("OrgDocUploader")
  sessions               Session[]
  profileUpdateReviews   ProfileUpdateRequest[]
  personalDocReviews     PersonalDocument[]    @relation("PersonalDocReviewer")
}

model Division {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  divisionId    String?
  parentId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  division      Division?      @relation(fields: [divisionId], references: [id])
  parent        Department?    @relation("DeptHierarchy", fields: [parentId], references: [id])
  children      Department[]   @relation("DeptHierarchy")
  employees     Employee[]
  teams         Team[]
  jobPostings   JobPosting[]
  leaveRequests LeaveRequest[]
}

model Team {
  id           String           @id @default(cuid())
  name         String
  category     EmployeeCategory @default(NON_TECHNICAL)
  departmentId String?
  headId       String?
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department?      @relation(fields: [departmentId], references: [id])
  head         Employee?        @relation("TeamHead", fields: [headId], references: [id])
  members      Employee[]       @relation("TeamMembership")
}

model Employee {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  userId             String               @unique
  firstName          String
  lastName           String
  middleName         String?
  gender             Gender?
  dateOfBirth        DateTime?
  maritalStatus      MaritalStatus?
  nationality        String?              @default("Nigerian")
  stateOfOrigin      String?
  profilePhoto       String?
  personalEmail      String?
  workEmail          String               @unique
  phone              String?
  alternatePhone     String?
  address            String?
  city               String?
  state              String?
  country            String?              @default("Nigeria")
  postalCode         String?
  departmentId       String?
  jobTitle           String?
  employmentType     EmploymentType       @default(FULL_TIME)
  category           EmployeeCategory     @default(NON_TECHNICAL)
  employeeStatus     EmployeeStatus       @default(ACTIVE)
  hireDate           DateTime?
  confirmationDate   DateTime?
  endDate            DateTime?
  managerId          String?
  departmentLeadId   String?
  teamId             String?
  bankName           String?
  bankAccountNo      String?
  bankAccountName    String?
  pensionPin         String?
  tin                String?
  nhfNo              String?
  grossSalary        Float?
  nokName            String?
  nokPhone           String?
  nokRelationship    String?
  nokAddress         String?
  onProbation        Boolean              @default(false)
  probationEndDate   DateTime?
  annualLeaveBalance Int                  @default(21)
  sickLeaveBalance   Int                  @default(14)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  appraisals         Appraisal[]
  docAcks            DocAck[]
  documents          Document[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  departmentLead     Employee?            @relation("DeptLeadRelation", fields: [departmentLeadId], references: [id])
  deptLeadOf         Employee[]           @relation("DeptLeadRelation")
  manager            Employee?            @relation("ManagerRelation", fields: [managerId], references: [id])
  directReports      Employee[]           @relation("ManagerRelation")
  team               Team?                @relation("TeamMembership", fields: [teamId], references: [id])
  ledTeams           Team[]               @relation("TeamHead")
  profileUpdateRequests ProfileUpdateRequest[]
  personalDocuments  PersonalDocument[]
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackGiven      Feedback[]           @relation("FeedbackGiver")
  feedbackReceived   Feedback[]           @relation("FeedbackReceiver")
  jobApplications    JobApplication[]
  kpis               KPI[]
  leaveApprovals     LeaveApproval[]
  leaveBalances      LeaveBalance[]
  reliefAssignments  LeaveReliefOfficer[] @relation("ReliefAssignments")
  leaveRequests      LeaveRequest[]       @relation("EmployeeLeave")
  reliefFor          LeaveRequest[]       @relation("ReliefOfficer")
  notifications      Notification[]       @relation("EmployeeNotifications")
  offboarding        Offboarding?
  onboardingTasks    OnboardingTask[]
  projectAssignments ProjectAssignment[]
  successionRoles    SuccessionPlan[]     @relation("CurrentRoleEmployee")
  successionPlans    SuccessionPlan[]     @relation("SuccessorEmployee")
  weeklyReports      WeeklyReport[]
  payslips           Payslip[]
}

model Document {
  id           String       @id @default(cuid())
  employeeId   String
  name         String
  type         DocumentType
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  expiryDate   DateTime?
  version      Int          @default(1)
  isLatest     Boolean      @default(true)
  uploadedById String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Announcement {
  id            String              @id @default(cuid())
  title         String
  body          String?             @db.Text
  type          AnnouncementType    @default(TEXT)
  videoUrl      String?
  imageUrl      String?
  behavior      AnnouncementBehavior @default(NOTIFICATION_BAR)
  status        AnnouncementStatus  @default(DRAFT)
  targetRoles   String[]            @default([])
  sendEmail     Boolean             @default(false)
  publishedAt   DateTime?
  retiredAt     DateTime?
  createdById   String
  createdBy     User                @relation("AnnouncementCreator", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum AnnouncementType {
  TEXT
  IMAGE
  VIDEO
}

enum AnnouncementBehavior {
  POPUP
  NOTIFICATION_BAR
  DASHBOARD_SCROLL
  EMAIL_ONLY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model OrgDocument {
  id              String         @id @default(cuid())
  title           String
  category        OrgDocCategory @default(OTHER)
  description     String?
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  canView         Boolean        @default(true)
  canDownload     Boolean        @default(false)
  canCopy         Boolean        @default(true)
  requiresAck     Boolean        @default(false)
  isActive        Boolean        @default(true)
  uploadedById    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  acknowledgments DocAck[]
  uploadedBy      User           @relation("OrgDocUploader", fields: [uploadedById], references: [id])
}

model DocAck {
  id             String      @id @default(cuid())
  documentId     String
  employeeId     String
  acknowledged   Boolean     @default(false)
  acknowledgedAt DateTime?
  signatureUrl   String?
  createdAt      DateTime    @default(now())
  document       OrgDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@unique([documentId, employeeId])
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  departmentId   String?
  description    String
  requirements   String?
  employmentType EmploymentType   @default(FULL_TIME)
  location       String?
  salaryMin      Float?
  salaryMax      Float?
  isInternal     Boolean          @default(false)
  status         JobStatus        @default(DRAFT)
  openDate       DateTime?
  closeDate      DateTime?
  requisitionId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]
  department     Department?      @relation(fields: [departmentId], references: [id])
  requisition    JobRequisition?  @relation(fields: [requisitionId], references: [id])
}

model JobRequisition {
  id             String            @id @default(cuid())
  title          String
  departmentId   String?
  description    String?
  employmentType EmploymentType    @default(FULL_TIME)
  isInternal     Boolean           @default(false)
  status         RequisitionStatus @default(PENDING)
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  jobPostings    JobPosting[]
}

model JobApplication {
  id              String            @id @default(cuid())
  jobPostingId    String
  employeeId      String?
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  resumeUrl       String?
  coverLetter     String?
  stage           ApplicationStage  @default(APPLICATION)
  status          ApplicationStatus @default(ACTIVE)
  notes           String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  interviews      Interview[]
  employee        Employee?         @relation(fields: [employeeId], references: [id])
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  offer           Offer?
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String
  scheduledAt   DateTime
  type          InterviewType   @default(TECHNICAL)
  interviewers  String?
  location      String?
  notes         String?
  feedback      String?
  rating        Int?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Offer {
  id            String         @id @default(cuid())
  applicationId String         @unique
  salary        Float
  startDate     DateTime?
  expiryDate    DateTime?
  status        OfferStatus    @default(PENDING)
  terms         String?
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model OnboardingTask {
  id          String             @id @default(cuid())
  employeeId  String
  title       String
  description String?
  category    OnboardingCategory @default(HR)
  assignedTo  String?
  dueDate     DateTime?
  status      TaskStatus         @default(PENDING)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveType {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  defaultDays     Int            @default(21)
  genderSpecific  Gender?
  waitingDays     Int            @default(0)
  rolloverPolicy  Boolean        @default(false)
  excludeWeekends Boolean        @default(true)
  requiresDoc     Boolean        @default(false)
  minDocDays      Int            @default(2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
}

model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  year      Int
  createdAt DateTime @default(now())
}

model LeaveFreezeperiod {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id                 String               @id @default(cuid())
  employeeId         String
  departmentId       String?
  leaveTypeId        String
  startDate          DateTime
  endDate            DateTime
  days               Int
  reason             String
  handoverNotes      String?
  documentUrl        String?
  status             LeaveStatus          @default(PENDING)
  version            Int                  @default(1)
  parentLeaveId      String?
  reliefEmployeeId   String?
  resumedAt          DateTime?
  reliefRating       Int?
  reliefComment      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ratingPromptShown  Boolean              @default(false)
  teamLeadIds        String?
  approvals          LeaveApproval[]
  reliefOfficersList LeaveReliefOfficer[]
  department         Department?          @relation(fields: [departmentId], references: [id])
  employee           Employee             @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType            @relation(fields: [leaveTypeId], references: [id])
  parentLeave        LeaveRequest?        @relation("LeaveReliefOfficers", fields: [parentLeaveId], references: [id])
  reliefOfficers     LeaveRequest[]       @relation("LeaveReliefOfficers")
  reliefEmployee     Employee?            @relation("ReliefOfficer", fields: [reliefEmployeeId], references: [id])
}

model LeaveApproval {
  id             String          @id @default(cuid())
  leaveRequestId String
  employeeId     String
  stage          ApprovalStage
  action         ApprovalAction?
  comment        String?
  actedAt        DateTime?
  deadline       DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employee       Employee        @relation(fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
}

model PerformanceCycle {
  id          String      @id @default(cuid())
  name        String
  year        Int
  half        Int         @default(1)
  startDate   DateTime
  endDate     DateTime
  kpiDeadline DateTime?
  isActive    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  appraisals  Appraisal[]
  kpis        KPI[]
}

model KPI {
  id            String            @id @default(cuid())
  employeeId    String
  cycleId       String
  title         String
  description   String?
  keyResultArea String?
  weight        Float
  target        String?
  deadline      DateTime?
  projectName   String?
  ownerId       String?
  status        KPIStatus         @default(DRAFT)
  kpiStatus     KPIProgressStatus @default(NOT_STARTED)
  progress      Int               @default(0)
  evidenceUrl   String?
  selfScore     Float?
  managerScore  Float?
  finalScore    Float?
  comments      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  cycle         PerformanceCycle  @relation(fields: [cycleId], references: [id])
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Appraisal {
  id               String           @id @default(cuid())
  employeeId       String
  cycleId          String
  kpiScore         Float?
  behavioralScore  Float?
  finalScore       Float?
  performanceBand  PerformanceBand?
  status           AppraisalStatus  @default(PENDING)
  selfCompleted    Boolean          @default(false)
  managerCompleted Boolean          @default(false)
  arcCompleted     Boolean          @default(false)
  comments         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cycle            PerformanceCycle @relation(fields: [cycleId], references: [id])
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  feedbacks        Feedback[]
}

model Feedback {
  id          String       @id @default(cuid())
  appraisalId String?
  giverId     String
  receiverId  String
  type        FeedbackType @default(PEER)
  rating      Float?
  comment     String?
  isAnonymous Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  appraisal   Appraisal?   @relation(fields: [appraisalId], references: [id])
  giver       Employee     @relation("FeedbackGiver", fields: [giverId], references: [id])
  receiver    Employee     @relation("FeedbackReceiver", fields: [receiverId], references: [id])
}

model WeeklyReport {
  id            String              @id @default(cuid())
  employeeId    String
  weekStart     DateTime
  weekEnd       DateTime
  status        ReportStatus        @default(DRAFT)
  supervisorId  String?
  totalScore    Float?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries       WeeklyReportEntry[]
}

model WeeklyReportEntry {
  id          String       @id @default(cuid())
  reportId    String
  date        DateTime
  task        String
  project     String?
  duration    Float
  description String
  outcome     String?
  learnings   String?
  challenges  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  report      WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  ownerId     String?
  status      ProjectStatus       @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id         String    @id @default(cuid())
  projectId  String
  employeeId String
  role       String?
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model Offboarding {
  id             String            @id @default(cuid())
  employeeId     String            @unique
  exitType       ExitType
  lastWorkingDay DateTime
  reason         String?
  status         OffboardingStatus @default(INITIATED)
  initiatedAt    DateTime          @default(now())
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  exitInterview  ExitInterview?
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks          OffboardingTask[]
}

model OffboardingTask {
  id            String      @id @default(cuid())
  offboardingId String
  title         String
  assignedTo    String?
  category      String?
  status        TaskStatus  @default(PENDING)
  dueDate       DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  offboarding   Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
}

model ExitInterview {
  id            String      @id @default(cuid())
  offboardingId String      @unique
  responses     Json?
  isAnonymous   Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  offboarding   Offboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
}

model SuccessionPlan {
  id              String             @id @default(cuid())
  roleTitle       String
  currentHolderId String?
  isCritical      Boolean            @default(false)
  riskLevel       RiskLevel          @default(HIGH)
  successorId     String?
  readiness       SuccessorReadiness @default(LONG_TERM)
  developmentPlan String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  currentHolder   Employee?          @relation("CurrentRoleEmployee", fields: [currentHolderId], references: [id])
  successor       Employee?          @relation("SuccessorEmployee", fields: [successorId], references: [id])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Int       @default(0)
  used        Int       @default(0)
  pending     Int       @default(0)
  carriedOver Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveReliefOfficer {
  id             String       @id @default(cuid())
  leaveRequestId String
  employeeId     String
  status         ReliefStatus @default(PENDING)
  acceptedAt     DateTime?
  declinedAt     DateTime?
  comment        String?
  rating         Int?
  ratingComment  String?
  ratedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation("ReliefAssignments", fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, employeeId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  employeeId String?
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  link       String?
  createdAt  DateTime         @default(now())
  employee   Employee?        @relation("EmployeeNotifications", fields: [employeeId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

enum OrgDocCategory {
  ONBOARDING
  POLICY
  SOP
  TEMPLATE
  OTHER
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  HR_ADMIN
  MANAGER
  DEPARTMENT_LEAD
  PROJECT_MANAGER
  STAFF
  INTERN
  TA_OFFICER
  PERFORMANCE_OFFICER
  AUDIT
  PAYROLL_OFFICER
  TEAM_LEAD
  PROJECT_LEAD
  RELIEF_OFFICER
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  NYSC
}

enum EmployeeCategory {
  TECHNICAL
  NON_TECHNICAL
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum DocumentType {
  CONTRACT
  ID
  CERTIFICATE
  POLICY
  OTHER
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum RequisitionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStage {
  APPLICATION
  ASSESSMENT
  TECHNICAL
  INTERVIEW
  MANAGEMENT_REVIEW
  OFFER
  ONBOARDING
}

enum ApplicationStatus {
  ACTIVE
  REJECTED
  WITHDRAWN
  HIRED
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  MANAGEMENT
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum OnboardingCategory {
  HR
  IT
  FINANCE
  ADMIN
  TEAM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ReliefStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CANCELLED_BY_ADMIN
}

enum ApprovalStage {
  RELIEF_OFFICER
  PROJECT_LEAD
  TEAM_LEAD
  MANAGER
  ADMIN
}

enum ApprovalAction {
  ACCEPTED
  APPROVED
  APPROVED_WITH_COMMENT
  REJECTED
  CLARIFICATION_REQUESTED
}

enum KPIStatus {
