enum KPIProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AppraisalStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  CALIBRATED
  FINALISED
}

enum PerformanceBand {
  OUTSTANDING
