// ── Surveys ──────────────────────────────────────────────────────────────────

enum SurveyType {
  GENERAL
  CONFIRMATION
  EXIT
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  RATING
  YES_NO
}

model SurveyTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        SurveyType
  isDefault   Boolean   @default(false)
  status      SurveyStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   SurveyTemplateQuestion[]
  surveys     Survey[]
}

model SurveyTemplateQuestion {
  id         String       @id @default(cuid())
  templateId String
  text       String
  qType      QuestionType @default(TEXT)
  options    Json?
  order      Int          @default(0)
  required   Boolean      @default(false)

  template   SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Survey {
  id          String       @id @default(cuid())
  title       String
  type        SurveyType
  isAnonymous Boolean      @default(false)
  status      SurveyStatus @default(DRAFT)
  templateId  String?
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  template    SurveyTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  questions   SurveyQuestion[]
  responses   SurveyResponse[]
}

model SurveyQuestion {
  id       String       @id @default(cuid())
  surveyId String
  text     String
  qType    QuestionType @default(TEXT)
  options  Json?
  order    Int          @default(0)
  required Boolean      @default(false)

  survey   Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]
}

model SurveyResponse {
  id          String    @id @default(cuid())
  surveyId    String
  employeeId  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  answers     SurveyAnswer[]
}

model SurveyAnswer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  answer     String?

  response   SurveyResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

